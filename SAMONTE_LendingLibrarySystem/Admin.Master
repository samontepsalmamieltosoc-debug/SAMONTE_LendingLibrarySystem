<%@ Master Language="C#" AutoEventWireup="true" CodeBehind="Admin.Master.cs" Inherits="SAMONTE_LendingLibrarySystem.AdminMaster" %>

<!DOCTYPE html>
<html>
<head runat="server">
    <title>Admin Portal - Lending Library System</title>
    <style>
        body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; margin: 0; padding: 0; background-color: #f4f6f9; }
        .navbar { background-color: #1e293b; color: white; padding: 15px 20px; display: flex; justify-content: space-between; align-items: center; }
        .navbar h2 { margin: 0; font-size: 20px; }
        .nav-links { display: flex; gap: 15px; align-items: center; }
        .nav-links a { color: #cbd5e1; text-decoration: none; font-weight: 500; padding: 6px 12px; border-radius: 4px; }
        .nav-links a:hover { background-color: #334155; color: #ffffff; }
        .logout-btn { background-color: #ef4444; color: white; border: none; padding: 6px 14px; border-radius: 4px; cursor: pointer; }
        .container { padding: 30px; max-width: 1200px; margin: 0 auto; }
        .card { background: white; padding: 25px; border-radius: 8px; box-shadow: 0 2px 8px rgba(0,0,0,0.08); margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 15px; }
        th, td { padding: 10px 12px; border: 1px solid #e2e8f0; text-align: left; }
        th { background-color: #f8fafc; font-weight: 600; }
        .btn { padding: 8px 16px; border: none; border-radius: 4px; cursor: pointer; color: white; background-color: #2563eb; }
        .form-group { margin-bottom: 15px; }
        .form-group label { display: block; margin-bottom: 5px; font-weight: 600; }
        .form-control { width: 100%; padding: 8px; border: 1px solid #cbd5e1; border-radius: 4px; box-sizing: border-box; }
    </style>
    <asp:ContentPlaceHolder ID="head" runat="server"></asp:ContentPlaceHolder>
</head>
<body>
    <form id="form1" runat="server">
        <div class="navbar">
            <h2>Lending Library — Admin Management</h2>
            <div class="nav-links">
                <a href="<%= ResolveUrl("~/Admin/AdminDashboard.aspx") %>">Analytics</a>
                <a href="<%= ResolveUrl("~/Admin/Inventory.aspx") %>">Inventory</a>
                <a href="<%= ResolveUrl("~/Admin/ManageUsers.aspx") %>">User</a>
                <a href="<%= ResolveUrl("~/Admin/ManageRequests.aspx") %>">Requests</a>
                <a href="<%= ResolveUrl("~/Admin/ManageDamagedItems.aspx") %>">Damaged Items</a>
                <a href="<%= ResolveUrl("~/Admin/ReturnedItems.aspx") %>">Returned Items</a>
                <asp:Button ID="btnLogout" runat="server" Text="Logout" CssClass="logout-btn" OnClick="btnLogout_Click" CausesValidation="false" />
            </div>
        </div>
        <div class="container">
            <asp:ContentPlaceHolder ID="MainContent" runat="server"></asp:ContentPlaceHolder>
        </div>
    </form>
</body>
</html>